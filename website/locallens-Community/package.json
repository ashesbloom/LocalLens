{
  "name": "locallens-community",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:vite": "vite",
    "build": "vite build && npm run check:sitekey",
    "check:sitekey": "! grep -rq 1x00000000000000000000AA dist/assets",
    "preview": "vite preview",
    "db:init": "wrangler d1 execute locallens-community --local --persist-to=.wrangler/state --file=schema.sql",
    "check:changelog": "node scripts/check-changelog-copy.mjs",
    "check:changelog-parse": "node src/data/changelog.test.mjs",
    "check:analytics": "node src/data/analytics.test.mjs",
    "check:shell": "node src/shell/commands.test.mjs",
    "check:lens": "node src/lens/dither.test.mjs",
    "check:blog": "node src/data/blog.test.mjs",
    "check:postHtml": "node src/data/postHtml.test.mjs",
    "check": "npm run check:changelog && npm run check:syncrelease && npm run check:changelog-parse && npm run check:analytics && npm run check:shell && npm run check:spark && npm run check:lens && npm run check:blog && npm run check:postHtml && npm run check:markdown && npm run check:postrules && npm run check:endpoints && npm run check:posts && npm run check:mdedit && npm run check:mine",
    "check:markdown": "node src/data/markdown.test.mjs",
    "check:postrules": "node src/data/postRules.test.mjs",
    "check:endpoints": "node scripts/check-endpoints.mjs",
    "check:posts": "node src/data/posts.test.mjs",
    "check:mdedit": "node src/data/mdEdit.test.mjs",
    "db:reset": "wrangler d1 execute locallens-community --local --persist-to=.wrangler/state --file=schema-drop.sql && npm run db:init",
    "check:mine": "node src/data/mine.test.mjs",
    "check:spark": "node src/shell/spark.test.mjs",
    "check:syncrelease": "node scripts/sync-release.test.mjs"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.0",
    "vite": "^8.2.2",
    "wrangler": "^4.131.0"
  }
}
