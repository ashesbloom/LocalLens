# Analytics collector (self-hosted, later). Unset = no network calls.
VITE_ANALYTICS_URL=
# Cloudflare Turnstile site key. Used by the community board's composer.
# For local development use Cloudflare's always-passes test pair, which needs no account:
#   VITE_TURNSTILE_SITEKEY=1x00000000000000000000AA
#   TURNSTILE_SECRET=1x0000000000000000000000000000000AA   (a Pages secret, not a Vite var)
# There is no fail-open path: with no secret set, every post is refused.
VITE_TURNSTILE_SITEKEY=
# Blogs! content API base URL. Unset = the live public instance.
VITE_BLOG_API=https://blogs-1626.onrender.com

# ── Pages Function secrets (server side; set with `wrangler pages secret put`) ──
# Never prefixed VITE_ — anything VITE_ is compiled into the browser bundle.
#   TURNSTILE_SECRET  server half of the bot check
#   IP_SALT           salt for the rate-limit hash; rotating it clears every counter
#   ADMIN_KEY         the x-admin-key header that authorises DELETE /api/posts/:id
#   POSTING_ENABLED   "0" makes the board read-only without a deploy
